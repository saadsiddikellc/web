# ---------------------------------------------------------------
# XUS — environment configuration
# Copy to .env for local development. Set the same keys in
# Netlify → Site configuration → Environment variables.
# Variables prefixed PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------

# Canonical origin used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://xus.co

# Where "BOOK A CALL" points. Leave empty to use the /contact page.
# e.g. a Cal.com / Calendly / HubSpot meetings link.
PUBLIC_BOOKING_URL=

# Contact form transport:
#   netlify  → Netlify Forms (default, zero config)
#   function → POST JSON to the bundled Netlify Function (/.netlify/functions/contact),
#              which forwards server-side to CONTACT_WEBHOOK_URL (keeps secrets private)
#   endpoint → POST JSON directly to PUBLIC_FORM_ENDPOINT (public endpoint only)
PUBLIC_FORM_PROVIDER=netlify
PUBLIC_FORM_ENDPOINT=

# Server-side only (used by netlify/functions/contact.mjs). Never prefix with PUBLIC_.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
