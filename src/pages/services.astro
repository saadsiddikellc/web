---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ServicesOverview from '@/components/sections/ServicesOverview.astro';
import CapabilityGrid from '@/components/sections/CapabilityGrid.astro';
import InsuranceFlow from '@/components/sections/InsuranceFlow.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import PricingScope from '@/components/sections/PricingScope.astro';
import BookCta from '@/components/ui/BookCta.astro';
import Button from '@/components/ui/Button.astro';
import CoreScene from '@/three/scenes/CoreScene';
import { services, capabilities } from '@/content/services';
import { siteConfig } from '@/config/site';

const schema = [
  ...services.map((s) => ({
    '@type': 'Service',
    name: s.title,
    description: s.body,
    provider: { '@id': `${siteConfig.url}/#organization` },
    serviceType: s.title,
    areaServed: 'Worldwide',
  })),
  {
    '@type': 'ItemList',
    name: 'XUS AI automation capabilities',
    itemListElement: capabilities.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, description: c.summary })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteConfig.url}/services` },
    ],
  },
];
---

<BaseLayout page="services" schema={schema}>
  <PageHero
    eyebrow="Services"
    title="AI agents &amp;<br/>AI automation."
    lede="We design and build autonomous systems that handle the repetitive work behind your business — customised to your size, complexity, integrations and scope."
    annotation="Scale"
  >
    <Fragment slot="actions">
      <div class="hero-actions">
        <BookCta />
        <Button href="#insurance" variant="ghost">Insurance use case</Button>
      </div>
    </Fragment>
    <div class="svc-hero-visual">
      <CoreScene client:visible ring steps={8} />
    </div>
  </PageHero>

  <ServicesOverview detailed />

  <section class="section section--tight custom" aria-labelledby="custom-title">
    <div class="container custom__grid">
      <h2 class="h2" id="custom-title" data-reveal>Built around your business,<br /><span class="em-metal">not a template.</span></h2>
      <div class="custom__body" data-reveal style="--reveal-delay:120">
        <p class="lede">No two operations are the same. Every workflow is scoped to:</p>
        <ul class="custom__list">
          <li><strong>Business size</strong> — the volume of leads, customers and requests you handle.</li>
          <li><strong>Complexity</strong> — how many decisions, branches and exceptions each process has.</li>
          <li><strong>Integrations</strong> — your CRM, inbox, calendar, policy and document systems.</li>
          <li><strong>Scope</strong> — how much the agent does autonomously versus escalates to your team.</li>
        </ul>
        <p class="body">Depending on workflow size and complexity, one XUS system can take on work that would normally need several people doing it by hand.</p>
      </div>
    </div>
  </section>

  <CapabilityGrid />
  <InsuranceFlow />
  <ProcessSteps />
  <PricingScope />
</BaseLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .svc-hero-visual {
    position: relative;
    aspect-ratio: 1 / 0.9;
    min-height: 320px;
    margin-inline: calc(var(--gutter) * -1);
  }
  .svc-hero-visual :global(.core-scene) {
    position: absolute;
    inset: 0;
  }
  .custom__grid {
    display: grid;
    gap: 2.5rem;
  }
  .custom__body {
    display: grid;
    gap: 1.4rem;
  }
  .custom__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .custom__list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-3);
  }
  .custom__list strong {
    color: var(--ink);
    font-weight: 500;
  }
  @media (min-width: 960px) {
    .custom__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
