---
import { formConfig } from '@/config/forms';
const f = formConfig.fields;
---

<form
  class="cform"
  name={formConfig.formName}
  method="POST"
  action="/contact?sent=1"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-contact-form
  novalidate
>
  <input type="hidden" name="form-name" value={formConfig.formName} />
  <p class="cform__hp" aria-hidden="true">
    <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="cform__grid">
    <div class="field">
      <label for="cf-name">{f.name.label}<span class="req" aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete={f.name.autocomplete} required aria-describedby="cf-name-err" />
      <p class="field__err" id="cf-name-err" data-err="name"></p>
    </div>
    <div class="field">
      <label for="cf-company">{f.company.label}</label>
      <input id="cf-company" name="company" type="text" autocomplete={f.company.autocomplete} />
    </div>
    <div class="field field--full">
      <label for="cf-email">{f.email.label}<span class="req" aria-hidden="true">*</span></label>
      <input id="cf-email" name="email" type="email" inputmode="email" autocomplete={f.email.autocomplete} required aria-describedby="cf-email-err" />
      <p class="field__err" id="cf-email-err" data-err="email"></p>
    </div>

    <fieldset class="field field--full choices" aria-describedby="cf-automate-err">
      <legend>{f.automate.label}<span class="req" aria-hidden="true">*</span></legend>
      <div class="choices__list">
        {
          formConfig.automateOptions.map((opt, i) => (
            <label class="choice">
              <input type="radio" name="automate" value={opt} required={i === 0} />
              <span>{opt}</span>
            </label>
          ))
        }
      </div>
      <p class="field__err" id="cf-automate-err" data-err="automate"></p>
    </fieldset>

    <div class="field field--full">
      <label for="cf-message">{f.message.label}</label>
      <textarea id="cf-message" name="message" rows="5" placeholder="A few lines about your team, tools and the work you want off your plate."></textarea>
    </div>
  </div>

  <div class="cform__foot">
    <p class="cform__note mono">We reply to schedule a call. No newsletters.</p>
    <button type="submit" class="btn" data-submit>
      <span data-submit-label>{formConfig.copy.submit}</span>
      <svg class="btn__arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.3"></path></svg>
    </button>
  </div>
  <p class="cform__status" role="status" aria-live="polite" data-status></p>
</form>

<div class="cform-done" data-form-done hidden tabindex="-1">
  <p class="eyebrow">Received</p>
  <p class="h2">Thank you.<br /><span class="em-metal">We’ll be in touch to book your call.</span></p>
</div>

<script>
  import { submitForm, validate } from '@/lib/forms/submit';
  import { formConfig } from '@/config/forms';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const done = document.querySelector<HTMLElement>('[data-form-done]');

  if (form && done) {
    if (new URLSearchParams(location.search).has('sent')) {
      form.hidden = true;
      done.hidden = false;
    }
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    const showErrors = (errors: Record<string, string>) => {
      form.querySelectorAll<HTMLElement>('[data-err]').forEach((el) => {
        const key = el.dataset.err!;
        el.textContent = errors[key] ?? '';
        const input = form.querySelector<HTMLElement>(`[name="${key}"]`);
        input?.setAttribute('aria-invalid', errors[key] ? 'true' : 'false');
      });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if (data['bot-field']) return;
      delete data['bot-field'];
      delete data['form-name'];
      const errors = validate(data);
      showErrors(errors);
      const first = Object.keys(errors)[0];
      if (first) {
        form.querySelector<HTMLElement>(`[name="${first}"]`)?.focus();
        return;
      }
      btn.disabled = true;
      label.textContent = formConfig.copy.sending;
      status.textContent = '';
      const res = await submitForm(data);
      btn.disabled = false;
      label.textContent = formConfig.copy.submit;
      if (res.ok) {
        form.hidden = true;
        done.hidden = false;
        done.focus();
      } else {
        status.textContent = formConfig.copy.error;
      }
    });
  }
</script>

<style>
  .cform {
    display: grid;
    gap: 2rem;
  }
  .cform__hp {
    position: absolute;
    left: -9999px;
  }
  .cform__grid {
    display: grid;
    gap: 1.6rem var(--gutter);
  }
  @media (min-width: 720px) {
    .cform__grid {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: 0.5rem;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .field > label,
  .field legend {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 0;
  }
  .req {
    color: var(--blue);
    margin-left: 0.3em;
  }
  .field input,
  .field textarea {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: transparent;
    padding: 0.7rem 0;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    border-radius: 0;
    transition: border-color 0.3s;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--blue);
    box-shadow: 0 1px 0 var(--blue);
  }
  .field textarea::placeholder {
    color: var(--metal);
  }
  .field [aria-invalid='true'] {
    border-bottom-color: #b2463a;
  }
  .field__err {
    min-height: 1em;
    font-size: 0.8rem;
    color: #b2463a;
  }
  .choices legend {
    margin-bottom: 0.9rem;
  }
  .choices__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .choice {
    position: relative;
    cursor: pointer;
  }
  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .choice span {
    display: inline-block;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9rem;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .choice:hover span {
    border-color: var(--ink);
  }
  .choice input:checked + span {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .choice input:focus-visible + span {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  .cform__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .cform__note {
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .cform__status {
    color: #b2463a;
    min-height: 1em;
  }
  .btn[disabled] {
    opacity: 0.6;
    pointer-events: none;
  }
  .cform-done {
    display: grid;
    gap: 1.2rem;
    padding: 3rem 0;
    outline: none;
  }
</style>
