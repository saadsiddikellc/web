---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`logo ${className}`}>
  <svg viewBox="0 0 88 24" width="88" height="24" aria-hidden="true">
    <!-- X -->
    <path d="M1 1h6.2L13 9.6 18.8 1H25l-8.8 11L25 23h-6.2L13 14.4 7.2 23H1l8.8-11z" fill="currentColor" />
    <!-- U -->
    <path d="M30 1h5.4v13.2c0 3 1.7 4.4 4.1 4.4s4.1-1.4 4.1-4.4V1H49v13.4c0 6-3.9 9.1-9.5 9.1S30 20.4 30 14.4z" fill="currentColor" />
    <!-- S -->
    <path d="M53.2 16.4h5.3c.3 1.8 1.9 2.7 4.3 2.7 2.2 0 3.6-.8 3.6-2.1 0-1.2-1-1.7-3.9-2.3l-2.1-.4c-4.4-.9-6.6-2.9-6.6-6.3C53.8 3.500 57.4 .5 62.7.5c5.5 0 8.8 2.8 9 7h-5.2c-.3-1.6-1.7-2.5-3.8-2.5-2 0-3.3.8-3.3 2.1 0 1.1 1 1.6 3.6 2.1l2.1.4c4.8.9 7 2.9 7 6.4 0 4.6-3.8 7.5-9.4 7.5-5.8 0-9.3-2.8-9.5-7.1z" fill="currentColor" />
    <rect x="78" y="17.5" width="5.5" height="5.5" fill="var(--blue)" />
  </svg>
  <span class="sr-only">XUS</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
  }
  .logo svg {
    height: 20px;
    width: auto;
  }
</style>
